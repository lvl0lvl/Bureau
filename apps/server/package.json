{
  "name": "@bureau/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "pair": "node --disable-warning=ExperimentalWarning src/cli.ts pair",
    "restore": "node --disable-warning=ExperimentalWarning src/restore.ts",
